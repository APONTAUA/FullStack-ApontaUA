APP_NAME=ApontaUA API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Substituir por credenciais locais; não usar valores deste exemplo em produção.
DATABASE_URL=postgresql+asyncpg://apontaua:apontaua@localhost:5432/apontaua

# Caminho persistente para os ficheiros originais carregados.
FILE_STORAGE_PATH=./var/files
MAX_UPLOAD_SIZE_MB=25

# Preencher quando a integração institucional for confirmada.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Preencher com os parâmetros Exim/mail.ua.pt aprovados.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

