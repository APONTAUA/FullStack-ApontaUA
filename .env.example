APP_NAME=ApontaUA API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Defina duas palavras-passe locais distintas antes de iniciar. Não reutilizar em produção.
POSTGRES_DB=apontaua
POSTGRES_USER=apontaua_admin
POSTGRES_PASSWORD=
DB_USER=apontaua_app
DB_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
API_PORT=8000

# Caminho persistente para os ficheiros originais carregados.
FILE_STORAGE_PATH=./var/files
MAX_UPLOAD_SIZE_MB=25

# Preencher quando a integração institucional for confirmada.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Preencher com os parâmetros Exim/mail.ua.pt aprovados.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Valores de desenvolvimento usados pelo Docker Compose.
# Substituir a palavra-passe antes de partilhar o ambiente.
POSTGRES_DB=apontaua
POSTGRES_USER=apontaua
POSTGRES_PASSWORD=apontaua_dev
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8080

