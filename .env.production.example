APP_NAME=ApontaUA API
APP_ENV=production
APONTAUA_ENV_FILE=.env.production
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Substituir estes valores no gestor de segredos do ambiente de deployment.
POSTGRES_DB=apontaua_prod
POSTGRES_USER=apontaua_admin
POSTGRES_PASSWORD=
DB_USER=apontaua_app
DB_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
API_PORT=8000

# Usar apenas origins e hosts reais aprovados para o deployment.
CORS_ORIGINS=[]
ALLOWED_HOSTS=["apontaua.example.invalid"]

FILE_STORAGE_PATH=/data/files
MAX_UPLOAD_SIZE_MB=25

OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
